{
  "$schema": "https://static.modelcontextprotocol.io/schemas/v1/server-card.schema.json",
  "name": "ai.exa/exa",
  "version": "3.5.1",
  "title": "Exa",
  "description": "Exa web search, page fetching and research-agent tools for AI agents over MCP.",
  "websiteUrl": "https://exa.ai",
  "icons": [
    {
      "src": "https://exa.ai/images/logo/exa-logomark-blue.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://exa.ai/images/favicon-32x32.png",
      "mimeType": "image/png",
      "sizes": [
        "32x32"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/exa-labs/exa-mcp-server",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.exa.ai/mcp",
      "headers": [
        {
          "name": "x-api-key",
          "description": "Exa API key. Optional: without it (or OAuth) the server runs at limited usage and without agent tools.",
          "isRequired": false,
          "isSecret": true
        }
      ],
      "supportedProtocolVersions": [
        "2025-11-25",
        "2025-06-18",
        "2025-03-26",
        "2024-11-05",
        "2024-10-07"
      ]
    }
  ],
  "transport": {
    "type": "streamable-http",
    "endpoint": "https://mcp.exa.ai/mcp"
  }
}